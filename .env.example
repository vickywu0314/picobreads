# Milestone 0 (prototype) needs no secrets.
# Optional: set when deploying to a sub-path (e.g. GitHub Pages). Leave empty on Vercel.
NEXT_PUBLIC_BASE_PATH=

# Public address of the site (used by sitemap.xml, robots.txt, canonical / Open Graph links).
# Defaults to https://pd.scentby.cn when empty.
NEXT_PUBLIC_SITE_URL=
