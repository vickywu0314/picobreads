# BeadSpark API — copy to /etc/beadspark/api.env on the server (chmod 600). Never commit real values.

# Where the site lives (used for links in emails and after login) and where the API listens.
SITE_URL=https://pd.scentby.cn
PORT=8787
# SQLite database file.
DB_PATH=/var/lib/beadspark/beadspark.db

# --- Email (verification codes) ---------------------------------------------
# QQ Mail: smtp.qq.com, port 465, SMTP_USER = full QQ email address,
# SMTP_PASS = the authorization code from QQ Mail settings (NOT the QQ password).
# Gmail: smtp.gmail.com, port 465, SMTP_PASS = a Google "app password".
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=BeadSpark

# --- Third-party login (leave empty to hide that button) ---------------------
# Callback URL to register on each platform: {SITE_URL}/api/auth/<provider>/callback
#   google · facebook · wechat · apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# WeChat Open Platform "website application" (微信开放平台 · 网站应用)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Sign in with Apple: Services ID, Team ID, Key ID and the .p8 private key on one line (\n for newlines)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
