# BeadSpark API — copy to /etc/beadspark/api.env on the server (chmod 600). Never commit real values.

# Where the site lives (used for links in emails and after login) and where the API listens.
SITE_URL=https://beadspark.top
PORT=8787
# SQLite database file.
DB_PATH=/var/lib/beadspark/beadspark.db

# --- Email (verification codes) ---------------------------------------------
# QQ Mail: smtp.qq.com, port 465, SMTP_USER = full QQ email address,
# SMTP_PASS = the authorization code from QQ Mail settings (NOT the QQ password).
# Gmail: smtp.gmail.com, port 465, SMTP_PASS = a Google "app password".
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=BeadSpark

# --- Third-party login (leave empty to hide that button) ---------------------
# Callback URL to register on each platform: {SITE_URL}/api/auth/<provider>/callback
#   google · facebook · wechat · apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# WeChat Open Platform "website application" (微信开放平台 · 网站应用)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# WeChat mini program (微信小程序): AppID + AppSecret from mp.weixin.qq.com → 开发管理 → 开发设置.
# WXMP_ENV: which version share codes open — release (default), trial (体验版) or develop.
WXMP_APP_ID=
WXMP_APP_SECRET=
WXMP_ENV=release
# Sign in with Apple: Services ID, Team ID, Key ID and the .p8 private key on one line (\n for newlines)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Shop: WeChat Pay (mini program) and prices --------------------------------
# Easiest: sudo bash ~/beadspark-deploy/set-shop.sh on the server.
# Merchant platform (pay.weixin.qq.com) → 账户中心 → API安全. The mini program's AppID must be
# linked to this merchant (产品中心 → AppID账号管理).
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
# Path of apiclient_key.pem on the server (or WXPAY_PRIVATE_KEY with the PEM on one line, \n for newlines)
WXPAY_PRIVATE_KEY_FILE=/etc/beadspark/apiclient_key.pem
# Must be https. Defaults to {SITE_URL}/api/pay/wechat/notify when SITE_URL is https.
WXPAY_NOTIFY_URL=
# Prices in yuan by pattern size: SMALL = 1 section, STANDARD = 2–4, LARGE = more.
# A form is on sale only when all three of its prices are set.
PRICE_KIT_SMALL=
PRICE_KIT_STANDARD=
PRICE_KIT_LARGE=
PRICE_FINISHED_SMALL=
PRICE_FINISHED_STANDARD=
PRICE_FINISHED_LARGE=
PRICE_SHIPPING=0
# New paid orders are emailed here (address, pattern link).
ADMIN_EMAIL=
# Password of the order admin page ({SITE_URL}/admin/), at least 12 characters. set-shop.sh makes one.
ADMIN_TOKEN=
