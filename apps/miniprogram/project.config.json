{
  "description": "BeadSpark 拼豆小程序",
  "miniprogramRoot": "miniprogram/",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "beadspark",
  "libVersion": "3.6.0",
  "setting": {
    "useCompilerPlugins": ["typescript"],
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true,
    "ignoreUploadUnusedFiles": true
  },
  "packOptions": {
    "ignore": [{ "type": "suffix", "value": ".d.ts" }],
    "include": []
  },
  "condition": {},
  "editorSetting": { "tabIndent": "insertSpaces", "tabSize": 2 }
}
