<view class="wrap">
  <view class="title">你想要哪种形式？</view>

  <view class="forms mt-lg">
    <view wx:for="{{forms}}" wx:key="id" class="form card {{form === item.id ? 'on' : ''}} {{item.open ? '' : 'soon'}}" data-id="{{item.id}}" bindtap="pick">
      <view wx:if="{{!item.open}}" class="veil"></view>
      <text wx:if="{{!item.open}}" class="pill sun tag">即将开放</text>
      <view class="row between"><text class="f-icon">{{item.icon}}</text><text wx:if="{{form === item.id}}" class="pill accent">✓ 已选</text></view>
      <view class="h2 mt-sm">{{item.title}}</view>
      <view class="muted small">{{item.body}}</view>
      <view wx:if="{{item.open}}" class="bold mt-sm price">{{item.price}}</view>
    </view>
  </view>

  <view class="card yours mt-lg">
    <image src="{{thumb}}" mode="aspectFit" class="thumb" />
    <view class="yours-info">
      <view class="row between"><text class="h2">你的图纸</text><text class="accent bold small" bindtap="edit">修改</text></view>
      <view class="stat" wx:for="{{stats}}" wx:key="k"><text class="muted small">{{item.k}}</text><text class="bold small">{{item.v}}</text></view>
    </view>
  </view>

  <view class="card list mt">
    <view class="row between" bindtap="toggleList"><text class="h2">材料清单 <text class="muted small">（{{legend.length}} 色）</text></text><text class="muted">{{listOpen ? '收起 ▲' : '展开 ▼'}}</text></view>
    <view wx:if="{{listOpen}}" class="legend mt">
      <view wx:for="{{legend}}" wx:key="code" class="chip">
        <view class="dot" style="background: {{item.hex}}"></view>
        <text class="bold small">{{item.code}}</text>
        <text class="muted small count">×{{item.count}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{form === 'digital'}}">
    <view class="mt-lg">
      <button class="btn primary block" hover-class="btn-hover" bindtap="saveSheet">保存图纸到相册</button>
      <button class="btn block mt" hover-class="btn-hover" bindtap="bead">{{started ? '继续在线拼' : '先在线拼拼看'}}</button>
    </view>
  </block>
  <block wx:else>
    <view class="card addr mt-lg" bindtap="chooseAddress">
      <view wx:if="{{address}}">
        <view class="bold">{{address.name}} {{address.phone}}</view>
        <view class="muted small">{{address.province}}{{address.city}}{{address.county}}{{address.detail}}</view>
      </view>
      <view wx:else class="bold">＋ 选择收货地址</view>
      <text class="muted">›</text>
    </view>
    <view class="card total mt">
      <view class="row between"><text class="muted">{{formName}}</text><text>{{itemPrice}}</text></view>
      <view class="row between"><text class="muted">运费</text><text>{{shipping}}</text></view>
      <view class="row between sum"><text class="bold">合计</text><text class="bold accent">{{total}}</text></view>
    </view>
    <view class="mt-lg">
      <button class="btn primary block" hover-class="btn-hover" disabled="{{paying}}" bindtap="pay">微信支付 {{total}}</button>
      <button class="btn block mt" hover-class="btn-hover" bindtap="bead">{{started ? '继续在线拼' : '先在线拼拼看'}}</button>
    </view>
    <view class="muted small center mt">{{form === 'kit' ? '材料包：按图纸数好的豆子（多 10% 备用）、底板、熨烫纸和打印好的图纸。' : '成品：我们按这张图拼好、熨烫好再寄给你。'}}定制商品付款后开始制作。</view>
  </block>
  <canvas wx:if="{{rendering}}" type="2d" id="sheet" class="sheet"></canvas>
</view>
