.me { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--sun); border: 3rpx solid var(--ink); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; flex-shrink: 0; }
.me-info { flex: 1; min-width: 0; }
.name-input { font-size: 32rpx; font-weight: 800; height: 52rpx; }
.empty { padding: 32rpx; text-align: center; box-shadow: none; border-color: var(--border); }
.center { text-align: center; }
.draft { display: flex; gap: 20rpx; padding: 20rpx; }
.thumb { width: 200rpx; height: 200rpx; border-radius: 20rpx; background: #f6efec; flex-shrink: 0; }
.draft-info { flex: 1; min-width: 0; }
.tiny { font-size: 22rpx; }
.bar { height: 10rpx; border-radius: 10rpx; background: var(--accent-soft); margin-top: 10rpx; overflow: hidden; }
.bar-fill { height: 100%; background: var(--accent); }
.mt-sm { margin-top: 12rpx; }
.del { margin-left: auto; padding: 8rpx; }
.group-title { font-size: 30rpx; font-weight: 800; }
