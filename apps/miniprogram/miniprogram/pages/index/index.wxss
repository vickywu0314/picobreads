.brand { padding: 8rpx 0; }
.logo { width: 72rpx; height: 72rpx; }
.brand-name { font-size: 44rpx; font-weight: 800; letter-spacing: -1rpx; }
.accent { color: var(--accent); }
.center { text-align: center; }
.pair { display: flex; align-items: center; gap: 16rpx; }
.pair-card { flex: 1; padding: 10rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; box-shadow: none; }
.pair-img { width: 100%; height: 260rpx; border-radius: 22rpx; }
.arrow { font-size: 40rpx; font-weight: 800; }
.resume { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; }
.features { display: flex; justify-content: space-between; }
.feature { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: 24rpx; }
.f-icon { font-size: 44rpx; color: var(--accent); }
