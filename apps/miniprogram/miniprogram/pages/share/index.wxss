.center { text-align: center; }
.empty { padding: 40rpx; text-align: center; }
.art-box { width: 100%; height: 560rpx; border-radius: 40rpx; background: var(--blush); overflow: hidden; }
.art { width: 100%; height: 560rpx; padding: 24rpx; box-sizing: border-box; }
.send { padding: 28rpx; }
.grow { flex: 1; padding: 0 16rpx; font-size: 28rpx; }
.legend { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12rpx; }
.chip { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 14rpx; border-radius: 18rpx; border: 2rpx solid var(--border); background: var(--surface); }
.dot { width: 32rpx; height: 32rpx; border-radius: 50%; box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.12); flex-shrink: 0; }
.count { margin-left: auto; }
.poster { position: fixed; left: -2000px; top: 0; width: 540px; height: 675px; }
