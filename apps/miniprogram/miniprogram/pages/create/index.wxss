.toggles { display: flex; gap: 16rpx; }
.toggle { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 20rpx 20rpx; box-shadow: none; border-color: var(--border); }
.toggle switch { transform: scale(0.8); }
.warn { border: 3rpx dashed var(--accent); border-radius: 24rpx; padding: 16rpx 20rpx; font-size: 24rpx; background: rgba(255,255,255,0.7); }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.opt { position: relative; padding: 16rpx; }
.opt.on { border-color: var(--accent); box-shadow: 0 0 0 6rpx rgba(217, 61, 114, 0.25); transform: translateY(-4rpx); }
.badges { position: absolute; left: 12rpx; right: 12rpx; top: 12rpx; z-index: 2; display: flex; gap: 8rpx; }
.badges .sel { margin-left: auto; }
.opt-art { position: relative; width: 100%; height: 300rpx; border-radius: 22rpx; background: #f6efec; margin-bottom: 12rpx; }
.opt-canvas { width: 100%; height: 300rpx; }
.opt-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.tiny { font-size: 22rpx; }
.center { text-align: center; }
.preview { padding: 24rpx; }
.seg-small .seg-item { padding: 8rpx 20rpx; font-size: 22rpx; }
.preview-box { position: relative; width: 100%; height: 620rpx; border-radius: 26rpx; background: var(--blush); }
.preview-photo { position: absolute; left: 24rpx; top: 24rpx; right: 24rpx; bottom: 24rpx; width: auto; height: auto; }
